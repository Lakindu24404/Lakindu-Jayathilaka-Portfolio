{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test:unit": "node --import ./tests/helpers/alias.mjs --test \"tests/unit/*.test.mts\"",
    "test:api": "node --env-file=../backend/.env.local --env-file=.env.local --import ./tests/helpers/alias.mjs --test \"tests/api/*.test.mts\"",
    "test:e2e": "node --env-file=../backend/.env.local --env-file=.env.local ./node_modules/@playwright/test/cli.js test",
    "qa": "node --env-file-if-exists=.env.local scripts/qa.mjs",
    "test": "npm run test:unit && npm run qa"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "lenis": "^1.3.26",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

# Copy to .env.local and fill in your own values — see ../docs/README.md.
# .env.local is git-ignored; nothing here is a real credential.
#
# These are the only variables the Next.js application reads. Both reach the
# browser, which is why the service-role key is not among them — it lives in
# ../backend/.env.local instead.

# Supabase project URL and its anon/public key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Absolute origin used for Open Graph image URLs. Optional: Vercel supplies
# VERCEL_PROJECT_PRODUCTION_URL, and localhost is assumed in development.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

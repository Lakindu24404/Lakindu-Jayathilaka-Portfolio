# Copy to .env.local and fill in your own values — see ./README.md.
# .env.local is git-ignored; nothing here is a real credential.
#
# Read by the seed import, the read-only audit and the database suites. None of
# this is bundled into the site — the Next.js application never loads this file.

# The same project the frontend points at.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon/public key, so the RLS suite can assert what an anonymous reader
# is and is not allowed to see.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Bypasses row level security. Never give this to the frontend or to Vercel's
# client-side variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The account `npm run seed` grants dashboard access to. Create the user in
# Supabase first (Authentication -> Users -> Add user).
SEED_ADMIN_EMAIL=you@example.com

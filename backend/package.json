{
  "name": "portfolio-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Supabase migrations, seed import and read-only database checks for the portfolio.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"tests/unit/*.test.mts\"",
    "test:db": "node --env-file=.env.local --test \"tests/db/*.test.mts\"",
    "test:audit": "node --env-file=.env.local tests/tools/audit.mjs",
    "test": "npm run test:unit && npm run test:db && npm run test:audit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5"
  }
}
